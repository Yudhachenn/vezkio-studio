{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEZKIO Studio",
  "version": "1.2.0",
  "identifier": "com.vezkio.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"VEZKIO Studio","width":1440,"height":920,"minWidth":1024,"minHeight":650,"resizable":true,"center":true}],
    "security": {"csp":null}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Create beyond the canvas",
    "category": "GraphicsAndDesign",
    "windows": {"nsis": {"installMode":"currentUser", "languages":["English"]}}
  }
}
